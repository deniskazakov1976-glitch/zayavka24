# === LLM (AnyModel / ProxyAPI / VseGPT / OpenAI) ===
# AnyModel: https://anymodel.org/v1
# ProxyAPI: https://api.proxyapi.ru/openai/v1
# VseGPT:   https://api.vsegpt.ru/v1
LLM_BASE_URL=https://anymodel.org/v1
LLM_API_KEY=sk-your-anymodel-or-proxyapi-key
LLM_MODEL=ds/deepseek-v4-flash-vision
LLM_TEMPERATURE=0.5

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=1234567890:your-botfather-token
# Telegram user IDs of admins (comma-separated, e.g. 123456789,987654321)
ADMIN_IDS=123456789
# Default Telegram chat/group ID where lead notifications are sent
DEFAULT_NOTIFY_CHAT_ID=123456789
# Default company slug when user opens /start without parameters
DEFAULT_COMPANY_SLUG=demo_detailing

# === Avito Messenger API (optional for Telegram-only demo mode) ===
AVITO_ENABLED=false
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_USER_ID=
AVITO_DEFAULT_COMPANY_SLUG=demo_detailing
# Hours to pause AI when the owner replies manually in Avito chat
AVITO_MANUAL_PAUSE_HOURS=24

# === Webhook Server & Dashboard ===
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
DASHBOARD_ENABLED=true
DASHBOARD_USER=admin
# Рекомендуется обязательно задать пароль при публикации в интернет
DASHBOARD_PASSWORD=
# Секретный токен для вебхука Авито (https://domain/webhook/avito/<секрет>)
AVITO_WEBHOOK_SECRET=
# Публичный URL вашего сервера/домена (для генерации ссылок на вебхук)
PUBLIC_BASE_URL=
# Домен для Caddy в docker-compose
DOMAIN=

# === Reliability & Guardrails ===
LLM_TIMEOUT_SEC=25.0
GUARDRAILS_MODE=enforce
DISCLOSE_AI=true

# === Storage ===
DB_PATH=data/bot.db
COMPANIES_DIR=companies
MAX_HISTORY_MESSAGES=14

# === Backups & Monitoring (Блок A) ===
# Как часто делать резервную копию (часы). Первый бэкап — сразу при старте.
BACKUP_INTERVAL_HOURS=6
# Сколько архивов хранить
BACKUP_KEEP=14
# Куда складывать архивы внутри контейнера
BACKUP_DIR=data/backups
# Выгрузка за пределы сервера: local — только локально, telegram — отправлять в чат владельца
BACKUP_REMOTE=local
# Алерты о сбоях в Telegram
ALERTS_ENABLED=true
ALERT_COOLDOWN_MINUTES=30
# Порог предупреждения о заполнении диска, %
DISK_WARN_PCT=90
# Порог критического остатка, МБ (ниже — статус fail и 503)
DISK_CRIT_FREE_MB=500

# === Цены LLM (Блок B) ===
# Рубли за 1k токенов. Применяются к модели из LLM_MODEL, если для неё нет цены в БД.
LLM_PRICE_PROMPT_RUB_PER_1K=0.15
LLM_PRICE_COMPLETION_RUB_PER_1K=0.60
