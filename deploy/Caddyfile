{$DOMAIN} {
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    # Public webhooks and healthcheck
    handle /webhook/* {
        reverse_proxy app:8080 {
            header_up X-Real-IP {remote_host}
        }
    }

    handle /health {
        reverse_proxy app:8080 {
            header_up X-Real-IP {remote_host}
        }
    }

    # Public client landing page
    handle /landing* {
        reverse_proxy app:8080 {
            header_up X-Real-IP {remote_host}
        }
    }

    # Security: hide OpenAPI / Swagger docs from external public
    handle /docs* {
        respond 404
    }

    handle /openapi.json {
        respond 404
    }

    handle /redoc* {
        respond 404
    }

    # Dashboard, Login, APIs and Client Portal (protected by application session & auth)
    handle {
        reverse_proxy app:8080 {
            header_up X-Real-IP {remote_host}
        }
    }

    log {
        output stdout
        format console
    }
}
