{$DOMAIN} {
    # Public webhooks and healthcheck
    handle /webhook/* {
        reverse_proxy app:8080
    }

    handle /health {
        reverse_proxy app:8080
    }

    # Public client landing page
    handle /landing* {
        reverse_proxy app:8080
    }

    # Security: hide OpenAPI / Swagger docs from external public
    handle /docs* {
        respond 404
    }

    handle /openapi.json {
        respond 404
    }

    handle /redoc* {
        respond 404
    }

    # Dashboard, Login, APIs and Client Portal (protected by application session & auth)
    handle {
        reverse_proxy app:8080
    }

    log {
        output stdout
        format console
    }
}
